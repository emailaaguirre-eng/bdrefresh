# Production origin (no trailing slash). Required for metadataBase, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://banddservicing.com

# Public GA4 Measurement ID (not a secret). Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# B&D Command Center visitor tracking (public site key from Managed Asset)
NEXT_PUBLIC_BDCC_VT_SITE_KEY=
NEXT_PUBLIC_BDCC_VT_SCRIPT_URL=https://bdcc.banddservicing.com/t.js

# Optional override for inquiry form POST URL (default: /api/contact)
# NEXT_PUBLIC_CONTACT_FORM_ACTION=/api/contact

# --- Contact / lead form (server-only; never commit real values) ---
# Comma-separated internal inboxes
CONTACT_FORM_RECIPIENTS=
# From address shown on outbound inquiry mail
CONTACT_FORM_FROM=
# submitter | none  (Reply-To uses the visitor email when submitter)
CONTACT_FORM_REPLY_TO_MODE=submitter
# true = accept + log safe summary, do not send SMTP
CONTACT_FORM_DRY_RUN=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# true/false — typically true for 465
SMTP_SECURE=true
